{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test --import tsx test/*.test.ts"
  },
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.d.ts",
    "!src/types.ts"
  ],
  "coverageAnalysis": "off",
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "concurrency": 4,
  "timeoutMS": 20000,
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 90
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
